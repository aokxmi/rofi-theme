


window {
  width: 500px;
  location: center;
  anchor: center;
  background-color: @bg1;
  border: 0px solid;
  border-radius: 24px;
  padding: 10px;
  margin: 10px;
  cursor: default;
}

mainbox {
  //background-color: @bg1;
  enabled: true;
  spacing: 0px;
  margin: 0px;
  padding: 0px;
  border: 0px solid;
  border-radius: 0px 0px 0px 0px;
  border-color: @selected;
  background-color: transparent;
  children: [ "inputbar", "listview" ];
}


/* INPUT BAR */

inputbar {
  enabled: true;
  spacing: 10px;
  padding: 15px;
  margin: 1px;
  border: 0px solid;
  border-radius: 14px;
  background-color: @bg0;
  text-color: @fg0;
  children: [ "prompt", "entry" ];
}


prompt {
  enabled: false;
}

textbox-prompt-colon {
  enabled: false;
  expand: true;
  background-color: @fg1;
  text-color: @fg1;
}

entry {
  placeholder: "Search";
  placeholder-color: @fg1;
  cursor: pointer;
  text-color: @fg0;
}


listview {
  enabled: true;
  columns: 1;
  lines: 5;
  scrollbar: false;
  dynamic: true;
  cycle: true;
  layout: vertical;
  reverse: false;

  spacing: 5px;
  padding: 5px;
  border: 0px solid;
  border-radius: 0px;
  cursor: default;
}

scrollbar {
  handle-width: 0px ;
  handle-color: @fg0;
  border-radius: 0px;
  background-color: @bg1;
}

/* ELEMENT */

element {
  enabled: true;
  spacing: 20px;
  border: 0px solid;
  border-radius: 12px;
  padding: 10px;
  orientation: horizontal;
  text-color: @fg0;
  background-color: transparent;
}

element selected.normal {
  background-color: @bg0;
  text-color: @fg0;
}

element normal.normal {
  background-color: @bg2;
  text-color: @fg1;
}

element alternate.normal {
  background-color: @bg2;
  text-color: @fg1;
}

element-icon {
  background-color: transparent;
  text-color: inherit;
  size: 44px;
}

element-text {
  background-color: transparent;
  vertical-align: 0.5;
}

/* ERROR MESSAGE */
error-message {
    padding:                     15px;
    border:                      2px solid;
    border-radius:               12px;
    border-color:                @selected;
    background-color:            @background;
    text-color:                  @foreground;
}
textbox {
    background-color:            @background;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
}
